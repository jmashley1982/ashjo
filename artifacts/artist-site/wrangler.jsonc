{
  // Deploys www.ashjo.com. Build first (`pnpm run build:static`), then
  // `pnpm run deploy` — the assets directory below must already exist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashjo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",

  "assets": {
    "directory": "dist/static",
    "binding": "ASSETS",
    // wouter routes /lookbook client-side, so unknown paths must return index.html
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "YOUTUBE_PLAYLIST_ID": "PL6jbjn9FqoxInDO6GKY2yFljdMdSiovdf"
  }

  // INSTAGRAM_ACCESS_TOKEN is a secret, not a var:
  //   npx wrangler secret put INSTAGRAM_ACCESS_TOKEN
  // Without it /api/instagram-feed returns an empty list, which is fine.
}
